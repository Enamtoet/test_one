 "lines": [
  {
   "id": "m01",
   "scene": "A",
   "text": "In Italian, you use one verb. In English, there are two.",
   "tr": "In italiano usi un solo verbo: «fare». In inglese sono due.",
   "key": "two"
  },
  {
   "id": "m02",
   "scene": "B",
   "text": "Do is for tasks and activities.",
   "tr": "Do: per compiti e attività.",
   "key": "activities"
  },
  {
   "id": "m03",
   "scene": "B",
   "text": "Make is when you create something.",
   "tr": "Make: quando crei qualcosa.",
   "key": "create"
  },
  {
   "id": "m04",
   "scene": "C",
   "text": "Do your homework. Do the shopping. Do sport.",
   "tr": "Fare i compiti. Fare la spesa. Fare sport.",
   "key": "sport"
  },
  {
   "id": "m05",
   "scene": "D",
   "text": "Make a cake. Make a mistake. Make a decision.",
   "tr": "Fare una torta. Fare un errore. Prendere una decisione.",
   "key": "decision"
  },
  {
   "id": "m06",
   "scene": "E",
   "text": "Quick test. Translate this.",
   "tr": "Test veloce. Traducilo.",
   "key": "test",
   "pause_after": 3
  },
  {
   "id": "m07",
   "scene": "E",
   "text": "Make a mistake. You create it.",
   "tr": "Make a mistake: l'errore lo «crei» tu.",
   "key": "create"
  },
  {
   "id": "m08",
   "scene": "F",
   "text": "Save this, and follow for the next rule.",
   "tr": "Salvalo, e seguimi per la prossima regola.",
   "key": "save"
  }
