{
 "name": "lesson3-for-since",
 "lines": [
  {
   "id": "f01",
   "scene": "A",
   "text": "Italians say this all the time. It's wrong.",
   "tr": "Gli italiani lo dicono sempre. È sbagliato.",
   "key": "wrong"
  },
  {
   "id": "f02",
   "scene": "B",
   "text": "For is a length of time.",
   "tr": "For: una durata.",
   "key": "length"
  },
  {
   "id": "f03",
   "scene": "B",
   "text": "Since is a starting point.",
   "tr": "Since: un punto di partenza.",
   "key": "starting"
  },
  {
   "id": "f04",
   "scene": "C",
   "text": "For five years. For two hours. Since twenty twenty. Since Monday.",
   "tr": "Da cinque anni. Da due ore. Dal 2020. Da lunedì.",
   "key": "monday"
  },
  {
   "id": "f05",
   "scene": "D",
   "text": "And use have, not the present: I've lived here for five years.",
   "tr": "E usa have, non il presente: I've lived here for five years.",
   "key": "lived"
  },
  {
   "id": "f06",
   "scene": "E",
   "text": "Your turn. Translate this.",
   "tr": "Tocca a te. Traducilo.",
   "key": "turn",
   "pause_after": 3
  },
  {
   "id": "f07",
   "scene": "E",
   "text": "March is a starting point. That's why we use since here.",
   "tr": "Marzo è un punto di partenza. Per questo si usa since.",
   "key": "since"
  },
  {
   "id": "f08",
   "scene": "F",
   "text": "Save this, and follow for one rule a day.",
   "tr": "Salvalo, e seguimi per una regola al giorno.",
   "key": "save"
  }
 ],
