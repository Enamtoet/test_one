  {
   "id": "p01",
   "scene": "A",
   "text": "Italians mix these two up every day.",
   "tr": "Gli italiani confondono questi due ogni giorno.",
   "key": "two"
  },
  {
   "id": "p02",
   "scene": "B",
   "text": "If you say when, use the past simple.",
   "tr": "Se dici quando, usa il past simple.",
   "key": "when"
  },
  {
   "id": "p03",
   "scene": "B",
   "text": "If the time doesn't matter, use the present perfect.",
   "tr": "Se il momento non conta, usa il present perfect.",
   "key": "perfect"
  },
  {
   "id": "p04",
   "scene": "C",
   "text": "I saw that film yesterday.",
   "tr": "Ho visto quel film ieri.",
